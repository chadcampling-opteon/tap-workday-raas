# Workday RaaS tap configuration
# Copy this file to .env and fill in your actual values.
# For reports, use config.json — see README for the full schema.

TAP_WORKDAY_RAAS_USERNAME=your_workday_username
TAP_WORKDAY_RAAS_PASSWORD=your_workday_password
# Optional. Defaults to 300 when unset. Set to null for no timeout.
# TAP_WORKDAY_RAAS_REQUEST_TIMEOUT=3600

# Reports are configured as a JSON array in config.json under the "reports" key.
# Example report entry:
# {
#   "report_name": "my_report",
#   "report_url": "https://wd2-impl-services1.workday.com/ccx/service/customreport2/...",
#   "key_properties": ["id"],
#   "state_param": "Posted_Date",
#   "replication_key": "Posted_Date",
#   "start_date": "2024-01-01T00:00:00Z",
#   "state_param_format": "datetime",
#   "paging": {"param": "End_Date", "size": "P14D"}
# }
